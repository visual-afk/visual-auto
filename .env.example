# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Resources
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_DOCS_FOLDER_ID=

# Google Analytics (추적 방식 변경 가능)
GA4_PROPERTY_ID=

# AI (Gemini 우선, Anthropic 폴백 — 둘 중 하나만 있으면 됨)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Google Chat 알림 (webhook URL)
GOOGLE_CHAT_WEBHOOK_URL=

# 네이버 검색광고 키워드도구 API (검색량 자동 조회 — npm run keywords)
# 발급: https://searchad.naver.com → 도구 → API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=
# 지점별 키워드 구글시트 ID (서비스 계정과 '편집자'로 공유 필요)
NAVER_KEYWORD_SHEET_ID=
