    { "id": "D05-03", "sec": "D05", "mat": "탈색이 하는 일", "fact": "멜라닌을 산화 분해 — 명도가 올라갈수록 결합도 희생" },
    { "id": "D05-04", "sec": "D05", "mat": "매직 vs 볼륨매직", "fact": "같은 화학, 다른 텐션·열 설계" },
