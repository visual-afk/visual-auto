    { "id": "D04-09", "sec": "D04", "mat": "모발이식의 원리", "fact": "후두부 모낭은 호르몬 영향을 덜 받아 옮겨도 유지", "verify": true },
    { "id": "D04-10", "sec": "D04", "mat": "가을 탈모", "fact": "여름 자외선·두피 스트레스의 청구서가 가을에 온다", "months": [9, 10, 11], "verify": true },
    { "id": "D05-01", "sec": "D05", "mat": "펌의 화학", "fact": "1제 환원(결합 절단) → 로드 모양 → 2제 산화(재결합)" },
