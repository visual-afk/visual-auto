    { "id": "D06-06", "sec": "D06", "mat": "'무OO' 마케팅 해부", "fact": "무실리콘·무설페이트가 항상 좋은 게 아닌 이유", "myth": true },
    { "id": "D06-07", "sec": "D06", "mat": "성분표 읽는 법", "fact": "앞 5개 성분이 사실상 그 제품의 정체" },
