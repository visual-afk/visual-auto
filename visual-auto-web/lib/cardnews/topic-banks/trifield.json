    { "id": "D01-01", "sec": "D01", "mat": "모발 인장강도", "fact": "한 올이 약 100g을 지탱", "verify": true, "hint": "전체 환산(코끼리급)은 계산 검증 후 사용" },
    { "id": "D01-02", "sec": "D01", "mat": "성장 속도", "fact": "월 1~1.5cm, 연 12~15cm" },
    { "id": "D01-03", "sec": "D01", "mat": "모발 개수", "fact": "평균 약 10만 개, 모공당 1~3올" },
    { "id": "D01-04", "sec": "D01", "mat": "모주기 3막극", "fact": "성장기 2~6년 / 퇴행기 2~3주 / 휴지기 2~3개월" },
    { "id": "D01-05", "sec": "D01", "mat": "곱슬의 비밀", "fact": "모낭 단면이 원형이면 직모, 타원·납작할수록 곱슬" },
    { "id": "D01-06", "sec": "D01", "mat": "모발 3층 구조", "fact": "큐티클(비늘)·코르텍스(강도·색)·메두라(심지)" },
    { "id": "D01-07", "sec": "D01", "mat": "멜라닌 2종", "fact": "유멜라닌(흑갈)+페오멜라닌(적황) 비율이 모든 머리색을 만든다" },
    { "id": "D01-08", "sec": "D01", "mat": "모발 굵기", "fact": "평균 0.05~0.09mm, 인종·부위별 차이", "verify": true },
    { "id": "D01-09", "sec": "D01", "mat": "케라틴 비중", "fact": "모발의 80~90%가 케라틴 단백질" },
    { "id": "D01-10", "sec": "D01", "mat": "밤에 더 자란다?", "fact": "성장은 모유두 혈류·호르몬 리듬의 영향 — 통설 검증 필요", "myth": true, "verify": true },
    { "id": "D02-01", "sec": "D02", "mat": "피지 분비량", "fact": "두피는 얼굴 T존급 피지 분비 부위", "verify": true },
    { "id": "D02-02", "sec": "D02", "mat": "두피 pH", "fact": "약산성 4.5~5.5 — 알칼리에 취약" },
    { "id": "D02-03", "sec": "D02", "mat": "각질 턴오버", "fact": "약 28일 주기 — 비듬은 주기가 무너진 신호" },
    { "id": "D02-04", "sec": "D02", "mat": "두피 상재균", "fact": "말라세지아 균과 비듬·가려움의 관계" },
    { "id": "D02-05", "sec": "D02", "mat": "머리 냄새의 정체", "fact": "피지가 산화되며 나는 냄새 — 안 감아서만이 아님" },
    { "id": "D02-06", "sec": "D02", "mat": "모공 막힘과 탈모", "fact": "피지가 모공을 막아 탈모? 과장된 통념 — 기전 검증", "myth": true, "verify": true },
    { "id": "D02-07", "sec": "D02", "mat": "두피 마사지와 혈류", "fact": "혈류 개선이 모발에 미치는 영향의 실제 근거 수준", "verify": true },
    { "id": "D02-08", "sec": "D02", "mat": "두피 타입 4종", "fact": "건성/지성/민감성/복합성 — 샴푸 선택 기준이 달라진다" },
    { "id": "D02-09", "sec": "D02", "mat": "두피도 늙는다", "fact": "두피 탄력 저하·혈류 감소가 모발 굵기에 주는 영향", "months": [10, 11] },
    { "id": "D02-10", "sec": "D02", "mat": "여름 두피", "fact": "땀+피지+자외선의 3중고 — 여름 두피 관리 원리", "months": [6, 7, 8] },
    { "id": "D03-01", "sec": "D03", "mat": "열손상 임계온도", "fact": "케라틴은 약 60℃부터 변성, 습윤모는 더 낮음" },
    { "id": "D03-02", "sec": "D03", "mat": "젖은 머리의 약점", "fact": "젖은 모발은 강도가 크게 떨어져 마찰·빗질에 취약", "verify": true },
    { "id": "D03-03", "sec": "D03", "mat": "버블 헤어", "fact": "젖은 모발에 고열 → 내부 수분이 끓어 기포 손상" },
    { "id": "D03-04", "sec": "D03", "mat": "자외선 손상", "fact": "UV는 모발 단백질·멜라닌을 분해 — 머리도 탄다", "months": [5, 6, 7, 8] },
    { "id": "D03-05", "sec": "D03", "mat": "수영장 염소", "fact": "염소가 큐티클과 멜라닌에 하는 일 (녹조 금발 사건)", "months": [6, 7, 8] },
