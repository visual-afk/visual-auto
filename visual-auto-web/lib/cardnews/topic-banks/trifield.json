    { "id": "D06-12", "sec": "D06", "mat": "고체 샴푸·저pH 트렌드", "fact": "포뮬라 형태가 바뀌면 뭐가 달라지나", "verify": true },
    { "id": "D07-01", "sec": "D07", "mat": "드라이기 온도", "fact": "뜨거운 바람의 실제 온도와 안전 거리 15cm", "verify": true },
    { "id": "D07-02", "sec": "D07", "mat": "고데기 판 재질", "fact": "세라믹 vs 티타늄 — 열전도와 손상의 관계" },
    { "id": "D07-03", "sec": "D07", "mat": "음이온 드라이기", "fact": "마케팅과 실제 효과의 간극 검증", "myth": true, "verify": true },
    { "id": "D07-04", "sec": "D07", "mat": "브러시 소재", "fact": "돈모·나일론·믹스 — 모질별 궁합" },
