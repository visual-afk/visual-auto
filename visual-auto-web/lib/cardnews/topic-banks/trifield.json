    { "id": "D06-09", "sec": "D06", "mat": "린스 vs 트리트먼트", "fact": "표면 코팅 vs 내부 충전 — 같은 회사 아님" },
    { "id": "D06-10", "sec": "D06", "mat": "향료와 두피", "fact": "향 좋은 샴푸의 대가 — 민감 두피와 알러젠 표기" },
